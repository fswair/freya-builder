          "response_expression": "{'ok': False, 'error': {'code': 'ALREADY_SET', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "card.stale",
          "when": "q['expected_version'] != s['cards'][q['card_id']]['version']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'STALE_VERSION', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "card.change",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'card_id': q['card_id'], 'locked': q['locked'], 'version': s['cards'][q['card_id']]['version']+1}}",
          "effects": [
            {
              "path_expression": "['cards',q['card_id'],'locked']",
              "value_expression": "q['locked']"
            },
            {
              "path_expression": "['cards',q['card_id'],'version']",
              "value_expression": "s['cards'][q['card_id']]['version']+1"
            },
            {
              "path_expression": "['cards',q['card_id'],'changed_this_call']",
              "value_expression": "True"
            },
