          "effects": []
        },
        {
          "id": "code.budget",
          "when": "s['wrong_codes'] >= 2",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'CODE_LOCKED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "code.pass",
          "when": "q['code'] == s['secret_code']",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'verified': True, 'wrong_left': 2-s['wrong_codes']}}",
          "effects": [
            {
              "path_expression": "['verified']",
              "value_expression": "True"
            }
          ]
        },
        {
          "id": "code.fail",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'verified': False, 'wrong_left': 1-s['wrong_codes']}}",
          "effects": [
            {
              "path_expression": "['wrong_codes']",
              "value_expression": "s['wrong_codes']+1"
            }
          ]
        }
      ],
      "repeat_behavior": "Read operations are repeatable while open; verification attempts and close behavior follow their explicit guards. Nothing is accepted after closure."
    },
