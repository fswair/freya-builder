        }
      ],
      "rules_are_ordered": true,
      "rule_semantics": "Choose the first true guard, evaluate response and every effect against the same PRE-state, then apply all effects atomically. No matching rule is a specification error.",
      "rules": [
        {
          "id": "inspect_cards.closed",
          "when": "s['closed']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'CLOSED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "inspect_cards.session",
          "when": "q['session_id'] != s['session_id']",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'SESSION_MISMATCH', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "cards.read",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'cards': s['cards']}}",
          "effects": []
        }
      ],
      "repeat_behavior": "Read operations are repeatable while open; verification attempts and close behavior follow their explicit guards. Nothing is accepted after closure."
    },
