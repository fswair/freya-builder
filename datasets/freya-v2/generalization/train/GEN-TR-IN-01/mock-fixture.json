          "rule_id": "TI.C1"
        }
      ],
      "rules_are_ordered": true,
      "rule_semantics": "Choose the first true guard, evaluate response and every effect against the same PRE-state, then apply all effects atomically. No matching rule is a specification error.",
      "rules": [
        {
          "id": "register_notice.closed",
          "when": "s['closed']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'CLOSED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "register_notice.session",
          "when": "q['session_id'] != s['session_id']",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'SESSION_MISMATCH', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "register_notice.key_conflict",
          "when": "q['request_key'] in s['receipts'] and (s['receipts'][q['request_key']]['request'] != q or s['receipts'][q['request_key']]['operation'] != op)",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'KEY_REUSE', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "register_notice.idempotent_replay",
          "when": "q['request_key'] in s['receipts']",
          "status": 200,
          "response_expression": "s['receipts'][q['request_key']]['response']",
          "effects": []
        },
        {
          "id": "notice.auth",
          "when": "not s['verified']",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'VERIFY_FIRST', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "notice.policy",
          "when": "q['policy_id'] != s['cover']['policy_id']",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'UNKNOWN_POLICY', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "notice.duplicate",
          "when": "s['notice'] is not None",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'ALREADY_LODGED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "notice.future",
          "when": "age_days(s['now'],q['occurred_on'])<0",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'FUTURE_EVENT', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "notice.old",
          "when": "age_days(s['now'],q['occurred_on']) > (10 if q['event_code']=='WATER_ESCAPE' else 7)",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'WINDOW_EXCEEDED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "notice.failure",
          "when": "s['write_failures_left']>0",
          "status": 503,
          "response_expression": "{'ok': False, 'error': {'code': 'TEMPORARY_UNAVAILABLE', 'commit_state': 'none'}}",
          "effects": [
            {
              "path_expression": "['write_failures_left']",
              "value_expression": "s['write_failures_left']-1"
            },
            {
              "path_expression": "['write_failures_seen']",
              "value_expression": "s['write_failures_seen']+1"
            }
          ]
        },
        {
          "id": "notice.create",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'notice_id':'NOTICE-1','policy_id':q['policy_id'],'event_code':q['event_code'],'occurred_on':q['occurred_on'],'location_code':q['location_code'],'status':'received_for_review'}}",
          "effects": [
            {
              "path_expression": "['notice']",
              "value_expression": "{'notice_id':'NOTICE-1','policy_id':q['policy_id'],'event_code':q['event_code'],'occurred_on':q['occurred_on'],'location_code':q['location_code'],'status':'received_for_review'}"
            },
            {
              "path_expression": "['receipts', q['request_key']]",
              "value_expression": "{'operation': op, 'request': q, 'response': {'ok': True, 'data': {'notice_id':'NOTICE-1','policy_id':q['policy_id'],'event_code':q['event_code'],'occurred_on':q['occurred_on'],'location_code':q['location_code'],'status':'received_for_review'}}}"
            },
            {
              "path_expression": "['mutation_count']",
              "value_expression": "s['mutation_count'] + 1"
            }
          ]
        }
      ],
      "repeat_behavior": "Exact same request_key+operation+payload replays the successful receipt without a new business mutation; a changed payload on the same key yields KEY_REUSE. Post-close operations are rejected. Additional product-state guards reject a second independent irreversible action."
    },
