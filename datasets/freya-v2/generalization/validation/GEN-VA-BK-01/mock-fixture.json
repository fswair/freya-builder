          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'SESSION_MISMATCH', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "set_delivery_preference.key_conflict",
          "when": "q['request_key'] in s['receipts'] and (s['receipts'][q['request_key']]['request'] != q or s['receipts'][q['request_key']]['operation'] != op)",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'KEY_REUSE', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "set_delivery_preference.idempotent_replay",
          "when": "q['request_key'] in s['receipts']",
          "status": 200,
          "response_expression": "s['receipts'][q['request_key']]['response']",
          "effects": []
        },
        {
          "id": "delivery.auth",
          "when": "not s['verified']",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'VERIFY_FIRST', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "delivery.unknown",
          "when": "q['account_id'] not in s['accounts']",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'UNKNOWN_ACCOUNT', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "delivery.email",
          "when": "q['mode']=='E_DELIVERY' and s['accounts'][q['account_id']]['email_state']!='VERIFIED'",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'CONTACT_UNVERIFIED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "delivery.repeat",
          "when": "s['accounts'][q['account_id']]['changed_this_call']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'ALREADY_CHANGED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "delivery.same",
          "when": "q['mode']==s['accounts'][q['account_id']]['mode']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'ALREADY_SET', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "delivery.cycle",
          "when": "q['effective_cycle'] != (s['accounts'][q['account_id']]['current_cycle'] if s['now'] <= s['accounts'][q['account_id']]['current_cycle'] + ('-18T19:00:00+00:00' if s['accounts'][q['account_id']]['kind']=='SAVINGS' else '-18T17:00:00+00:00') else s['accounts'][q['account_id']]['next_cycle'])",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'WRONG_CYCLE', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "delivery.change",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'account_id':q['account_id'],'mode':q['mode'],'effective_cycle':q['effective_cycle']}}",
          "effects": [
            {
              "path_expression": "['accounts',q['account_id'],'mode']",
              "value_expression": "q['mode']"
            },
            {
              "path_expression": "['accounts',q['account_id'],'effective_cycle']",
              "value_expression": "q['effective_cycle']"
            },
            {
              "path_expression": "['accounts',q['account_id'],'changed_this_call']",
              "value_expression": "True"
            },
            {
              "path_expression": "['receipts', q['request_key']]",
              "value_expression": "{'operation': op, 'request': q, 'response': {'ok': True, 'data': {'account_id':q['account_id'],'mode':q['mode'],'effective_cycle':q['effective_cycle']}}}"
            },
            {
              "path_expression": "['mutation_count']",
              "value_expression": "s['mutation_count'] + 1"
            }
          ]
        }
      ],
      "repeat_behavior": "Exact same request_key+operation+payload replays the successful receipt without a new business mutation; a changed payload on the same key yields KEY_REUSE. Post-close operations are rejected. Additional product-state guards reject a second independent irreversible action."
    },
