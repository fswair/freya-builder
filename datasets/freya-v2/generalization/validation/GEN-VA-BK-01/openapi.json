        "description": "Check one complete delivery-access challenge; two wrong attempts exhaust the budget Policy references: documents/policy.txt#VB.P1.",
        "x-policy-refs": [
          {
            "file": "documents/policy.txt",
            "rule_id": "VB.P1"
          }
