            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "challenge_response": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{4}$"
                  }
                },
                "required": [
                  "session_id",
                  "challenge_response"
                ],
                "additionalProperties": false
              }
            }
          }
        },
