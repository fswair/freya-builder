  "specification_notice": "This is a declarative mock SPECIFICATION. A local tool adapter must implement it; no Freya endpoint/customer registration is implied. The supplied verifier only evaluates authored proof witnesses, not a phone workflow or a mock server.",
  "clock_timezone": "UTC",
  "clock_rule": "Each independent case starts from its own initial_state.now. Only an explicit listed transition may advance it; never use the host wall clock.",
  "expression_language": "Restricted side-effect-free Python expression subset documented by validation_support.py. q=request, s=pre-state, op=operation. Decimal-safe money and calendar helpers are pure. Effects are simultaneous; receipts hold deep copies.",
  "case_isolation": {
    "reset": "deep-copy the selected case initial_state before every repetition",
    "shared_mutable_state": false,
    "case_order_dependency": false
  },
  "identifier_mapping": "All usable entity IDs are keys/IDs of the selected initial_state and must be grounded in the relevant read response. Caller aliases appear in customer_private_facts. No external lookup is allowed.",
  "operation_models": {
    "get_renewal_offers": {
      "policy_refs": [
        {
          "file": "brief.txt",
          "rule_id": "VI.1"
        },
        {
          "file": "brief.txt",
          "rule_id": "VI.2"
        }
      ],
      "rules_are_ordered": true,
      "rule_semantics": "Choose the first true guard, evaluate response and every effect against the same PRE-state, then apply all effects atomically. No matching rule is a specification error.",
      "rules": [
        {
          "id": "get_renewal_offers.closed",
          "when": "s['closed']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'CLOSED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "get_renewal_offers.session",
          "when": "q['session_id'] != s['session_id']",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'SESSION_MISMATCH', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "offers.read",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'channel_verified':True,'offers':values(s['offers'])}}",
          "effects": []
        }
      ],
      "repeat_behavior": "Read operations are repeatable while open; verification attempts and close behavior follow their explicit guards. Nothing is accepted after closure."
    },
    "record_renewal_choice": {
      "policy_refs": [
