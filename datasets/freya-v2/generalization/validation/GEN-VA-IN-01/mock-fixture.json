          "rule_id": "VI.6"
        }
      ],
      "rules_are_ordered": true,
      "rule_semantics": "Choose the first true guard, evaluate response and every effect against the same PRE-state, then apply all effects atomically. No matching rule is a specification error.",
      "rules": [
        {
          "id": "record_renewal_choice.closed",
          "when": "s['closed']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'CLOSED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "record_renewal_choice.session",
          "when": "q['session_id'] != s['session_id']",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'SESSION_MISMATCH', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "record_renewal_choice.key_conflict",
          "when": "q['request_key'] in s['receipts'] and (s['receipts'][q['request_key']]['request'] != q or s['receipts'][q['request_key']]['operation'] != op)",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'KEY_REUSE', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "record_renewal_choice.idempotent_replay",
          "when": "q['request_key'] in s['receipts']",
          "status": 200,
          "response_expression": "s['receipts'][q['request_key']]['response']",
          "effects": []
        },
        {
          "id": "offer.unknown",
          "when": "q['offer_id'] not in s['offers']",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'UNKNOWN_OFFER', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "offer.expired",
          "when": "s['now'] > s['offers'][q['offer_id']]['expires_at']",
          "status": 422,
          "response_expression": "{'ok': False, 'error': {'code': 'OFFER_EXPIRED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "offer.decided",
          "when": "s['offers'][q['offer_id']]['policy_id'] in s['decisions']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'ALREADY_DECIDED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "offer.decide",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'policy_id':s['offers'][q['offer_id']]['policy_id'],'choice':q['choice'],'status':'choice_recorded','charged':False}}",
          "effects": [
            {
              "path_expression": "['decisions',s['offers'][q['offer_id']]['policy_id']]",
              "value_expression": "q['choice']"
            },
            {
              "path_expression": "['receipts', q['request_key']]",
              "value_expression": "{'operation': op, 'request': q, 'response': {'ok': True, 'data': {'policy_id':s['offers'][q['offer_id']]['policy_id'],'choice':q['choice'],'status':'choice_recorded','charged':False}}}"
            },
            {
              "path_expression": "['mutation_count']",
              "value_expression": "s['mutation_count'] + 1"
            }
          ]
        }
      ],
      "repeat_behavior": "Exact same request_key+operation+payload replays the successful receipt without a new business mutation; a changed payload on the same key yields KEY_REUSE. Post-close operations are rejected. Additional product-state guards reject a second independent irreversible action."
    },
    "close_renewal": {
      "policy_refs": [
        {
          "file": "brief.txt",
          "rule_id": "VI.7"
        }
      ],
      "rules_are_ordered": true,
      "rule_semantics": "Choose the first true guard, evaluate response and every effect against the same PRE-state, then apply all effects atomically. No matching rule is a specification error.",
      "rules": [
        {
          "id": "close_renewal.closed",
          "when": "s['closed']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'CLOSED', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "close_renewal.session",
          "when": "q['session_id'] != s['session_id']",
          "status": 403,
          "response_expression": "{'ok': False, 'error': {'code': 'SESSION_MISMATCH', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "close.choices",
          "when": "len(s['decisions'])>0 and q['code'] != ('mixed' if count_value(s['decisions'],'renew')>0 and count_value(s['decisions'],'let_expire')>0 else ('renewed' if count_value(s['decisions'],'renew')>0 else 'lapsed'))",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'BAD_CLOSE', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "close.none",
          "when": "len(s['decisions'])==0 and q['code'] in ['renewed','lapsed','mixed']",
          "status": 409,
          "response_expression": "{'ok': False, 'error': {'code': 'BAD_CLOSE', 'commit_state': 'none'}}",
          "effects": []
        },
        {
          "id": "close.ok",
          "when": "True",
          "status": 200,
          "response_expression": "{'ok': True, 'data': {'code':q['code']}}",
          "effects": [
            {
              "path_expression": "['closed']",
              "value_expression": "True"
            },
            {
              "path_expression": "['final_code']",
              "value_expression": "q['code']"
            }
          ]
        }
      ],
      "repeat_behavior": "Read operations are repeatable while open; verification attempts and close behavior follow their explicit guards. Nothing is accepted after closure."
    }
