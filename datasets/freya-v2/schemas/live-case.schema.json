{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEV-(TR|VA|HO)-[AB]-[0-9]{3}$"
    },
    "practice_session_case": {
      "type": "string",
      "pattern": "^PUB-(0[1-9]|1[0-3])$"
    },
    "brief": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "variables": {
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "enum": [
            "Mr",
            "Ms"
          ]
        },
        "now": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "title",
        "now"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "date_of_birth": {
          "type": "string",
          "format": "date"
        },
        "phone_last4": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      },
      "required": [
        "date_of_birth",
        "phone_last4"
      ],
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "credit_card",
              "personal_loan",
              "car_loan"
            ]
          },
          "past_due": {
            "type": "number",
            "minimum": 0
          },
          "days_late": {
            "type": "integer",
            "minimum": 1,
            "maximum": 45
          },
          "card_last4": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "minimum_payment": {
            "type": "number",
            "minimum": 0
          },
          "instalment_amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "type",
          "past_due",
          "days_late"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "minLength": 100
    },
    "expected": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "promise",
            "paid",
            "transferred",
            "no_promise",
            "not_verified",
            "not_reached"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "promises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "pattern": "^p[1-3]$"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "product_id",
              "amount",
              "date"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "pattern": "^p[1-3]$"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "refused",
                  "hardship",
                  "dispute",
                  "paid",
                  "service_error"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "product_id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "callbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "time": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9]$"
              }
            },
            "required": [
              "date",
              "time"
            ],
            "additionalProperties": false
          }
        },
        "transfers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "queue": {
                "type": "string",
                "enum": [
                  "general",
                  "support",
                  "restructuring"
                ]
              }
            },
            "required": [
              "queue"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "outcome",
        "reason",
        "promises",
        "notes",
        "callbacks",
        "transfers"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string"
        },
        "split": {
          "type": "string",
          "enum": [
            "train",
            "validation",
            "holdout"
          ]
        },
        "variant": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "behavior_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "state_tone_transitions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "rule_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "rule_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "pointer": {
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "pointer"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        "oracle_reasoning": {
          "type": "string",
          "minLength": 20
        },
        "specific_risk": {
          "type": "string",
          "minLength": 10
        },
        "derived_terms": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ledger_assertions": {
          "type": "object"
        }
      },
      "required": [
        "group_id",
        "split",
        "variant",
        "behavior_labels",
        "state_tone_transitions",
        "rule_refs",
        "oracle_reasoning",
        "specific_risk",
        "derived_terms",
        "ledger_assertions"
      ],
      "additionalProperties": true
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "create_promise"
            ]
          },
          "fail_first_n": {
            "type": "integer",
            "const": 1
          }
        },
        "required": [
          "tool",
          "fail_first_n"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "practice_session_case",
    "brief",
    "variables",
    "identity",
    "products",
    "family",
    "level",
    "title",
    "script",
    "expected",
    "checks",
    "metadata"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
