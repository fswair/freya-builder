  "live_adapter_contract": {
    "session_creation": "Use practice_session_case exactly, not the DEV id. Only PUB-01 through PUB-13 are registered.",
    "customer_simulation": "Requires a harness that can run the supplied English customer script while preserving the registered seed. This capability has NOT been verified against a Freya runner; no custom-customer upload endpoint is assumed.",
    "runtime_variables": "Preserve seed variables verbatim. customer_id is supplied by the new bank session, not invented here. Pass no evaluator metadata, expected ledger, checks or faults as test_variables.",
    "faults": "Existing seed-specific faults are copied as evidence; do not inject new failures into the live backend.",
    "product_mapping": "p1,p2,... refer to the actual get_account order documented in the public seed expectations; never invent an ID absent from get_account.",
    "holdout": "Only IDs, paths, counts and split membership are exposed by this shared manifest. Holdout content is in live/holdout.json."
  },
  "split_protocol": {
    "train": "optimizer/reflection input",
    "validation": "candidate selection only",
    "holdout": "open after candidate selection; never reflection or repair"
