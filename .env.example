# Offline checks do not require credentials or call external APIs.
# The builder uses codex-auth-helper==1.10.1 with the existing ~/.codex/auth.json session.
# These provider keys are optional and do not replace that builder authentication path.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Required for Freya validation, publication, export and synthetic practice simulations.
FREYA_API_KEY=
# Optional persistent practice-bank team key (16+ characters).
# If omitted, the practice client creates .freya-team-key locally and reuses it.
FREYA_BANK_TEAM_KEY=
